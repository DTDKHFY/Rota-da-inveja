{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. Autoteste (comeca por aqui)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/orquestrador.py",
      "args": ["autoteste"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "2. Doctor (verifica a configuracao)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/orquestrador.py",
      "args": ["doctor"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "3. Correr (bot + worker)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/orquestrador.py",
      "args": ["correr"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Programador — autoteste",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/programador.py",
      "args": ["autoteste"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Programador — ver ficheiros editaveis",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/programador.py",
      "args": ["ver", "--projeto", "${input:projeto}"],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ],
  "inputs": [
    {
      "id": "projeto",
      "type": "promptString",
      "description": "Caminho do teu projeto de backtest",
      "default": "C:\\codigo\\teste backtest"
    }
  ]
}
